APP_NAME="Saud International Schools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sis
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ENABLE_PERMISSIONS=

# Media / Uploads
MEDIA_DISK=public
FILE_MAX_SIZE=10485760
FILE_QUARANTINE_DISK=quarantine
FILE_DEFAULT_FOLDER=uploads
FILE_SCANNER=null
FILE_ALLOWED_IMAGES=jpg,jpeg,png,gif,webp,svg
FILE_ALLOWED_DOCUMENTS=pdf,doc,docx,xls,xlsx,csv,ppt,pptx,txt,zip
FILE_ALLOWED_VIDEOS=mp4,avi,mov,wmv,flv
FILE_ALLOWED_AUDIO=mp3,wav,ogg,m4a

# ClamAV (used when FILE_SCANNER=clamav)
CLAMAV_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30


# Azure AD SSO (Socialite)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI="${APP_URL}/api/v1/admin/auth/azure/callback"

# Trusted proxies
# Read by App\Http\Middleware\TrustProxies. EMPTY = trust no proxy, so request()->ip()
# is the address that actually connected. Public forms gate per-IP submission caps and
# per-form IP/country blocks on that value, so do NOT set this to '*' for convenience:
# the app would then believe any client's X-Forwarded-For and both gates could be
# walked past. Set it at deploy time only, and only to proxies you control — '*' when
# the app is reachable ONLY through your load balancer/CDN, otherwise a comma-separated
# list of proxy addresses.
TRUSTED_PROXIES=

# Private uploads (not web-readable; served only through a signed, permission-gated route)
PRIVATE_MEDIA_DISK=local
FILE_PRUNE_PRIVATE_AFTER_DAYS=7

# Integrations (outbound HTTP timeout for driver calls, seconds)
INTEGRATIONS_TIMEOUT=15

# Notifications
NOTIFICATIONS_PRUNE_AFTER_DAYS=90

# Newsletter (code NewsletterGroupsSeeder keys its firstOrCreate on)
NEWSLETTER_DEFAULT_GROUP=general

# Forms — submission token lifetime (minutes)
FORMS_TOKEN_TTL=120

# Forms — spam scoring
FORMS_MIN_SUBMIT_SECONDS=5
FORMS_SPAM_THRESHOLD=50

# Forms — uploads
FORMS_MAX_UPLOADS_PER_SESSION=10
FORMS_SCAN_WAIT_SECONDS=15

# Forms — submissions (completed ones are never pruned — they are the record).
# FORMS_ABANDON_AFTER_MINUTES must stay well below FORMS_PRUNE_STARTED_AFTER_HOURS,
# or the nightly prune deletes drafts before they are ever classified as abandoned.
FORMS_PRUNE_AFTER_DAYS=90
FORMS_PRUNE_STARTED_AFTER_HOURS=24
FORMS_ABANDON_AFTER_MINUTES=30
FORMS_MAX_DRAFTS_PER_HOUR=20
FORMS_FILE_LINK_TTL=30
FORMS_EXPORT_CHUNK=500

# Forms — webhooks (seconds; mandatory while the queue is sync)
FORMS_WEBHOOK_TIMEOUT=10

# Forms — rate limits (per minute)
FORMS_SUBMITS_PER_MINUTE=10
FORMS_UPLOADS_PER_MINUTE=20
FORMS_TELEMETRY_PER_MINUTE=60

# Forms — capture (counts and timings only; keystroke content is never transmitted)
FORMS_CAPTURE_TIMING=true
FORMS_CAPTURE_BEHAVIOUR=true
FORMS_CAPTURE_SCROLL=true
FORMS_CAPTURE_KEYSTROKES=true
FORMS_CAPTURE_MOUSE=false
